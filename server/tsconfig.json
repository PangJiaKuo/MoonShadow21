{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "baseUrl": "..",
    "paths": {
      "@moon21/shared": ["shared/src/index.ts"],
      "@moon21/engine": ["engine/src/index.ts"]
    }
  },
  "include": ["src"]
}
